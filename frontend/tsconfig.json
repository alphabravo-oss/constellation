{
  // TypeScript 6.0.x, not 7.0.2: the 7.x npm package is the native (Go) compiler and only ships
  // `tsc`; its JS entry has no createProgram/createSourceFile, so @typescript-eslint/parser cannot
  // load it (its peer range is also `typescript <6.1`). Re-evaluate once typescript-eslint
  // supports 7.x. `baseUrl` was dropped because TS 6 deprecates it; `paths` resolve relative to
  // this file. TS 6 no longer auto-includes @types/*, hence the explicit `types`.
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
