# Canonical dev-loop defaults (tracked). Per-developer overrides go in .env.dev.local (gitignored,
# auto-created from this file by scripts/dev.sh). Ports are chosen not to collide with a host k3s
# (6443/10250/80/443), the legacy test Postgres on 15433, or the observability stack.
DEV_PG_PORT=15432
DEV_PG_USER=constellation
DEV_PG_PASSWORD=constellation
DEV_PG_DB=constellation
DATABASE_URL=postgres://constellation:constellation@127.0.0.1:15432/constellation?sslmode=disable

# constellation-api
LISTEN_ADDR=:18080
ADMIN_LISTEN_ADDR=:18081
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONSTELLATION_LOG_LEVEL=debug
CONSTELLATION_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# constellation-scanner (tools such as trivy/grype/syft must be on PATH for real scans)
CONSTELLATION_API_URL=http://127.0.0.1:18080
SCANNER_LISTEN_ADDR=:18084

# constellation-operator — watches an isolated namespace so a dev operator never fights the
# operator deployed in the cluster. Point KUBECONFIG at the cluster you want to use.
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
OPERATOR_NAMESPACE=constellation-dev
WATCH_NAMESPACE=constellation-dev

# frontend (Vite)
VITE_PORT=5173
VITE_API_URL=http://127.0.0.1:18080

# Seeded admin for the dev loop (constellation-seed)
DEV_ADMIN_EMAIL=admin@demo.test
DEV_ADMIN_PASSWORD=Constellation!1
