# Canonical dev-loop defaults (tracked). Per-developer overrides go in .env.dev.local (gitignored,
# auto-created from this file by scripts/dev.sh). Ports are chosen not to collide with a host k3s
# (6443/10250/80/443), the testcontainers used by `make test-integration`, or the observability stack.
DEV_PG_PORT=15432
DEV_PG_USER=constellation
DEV_PG_PASSWORD=constellation
DEV_PG_DB=constellation
DATABASE_URL=postgres://constellation:constellation@127.0.0.1:15432/constellation?sslmode=disable

# constellation-api
LISTEN_ADDR=:18080
ADMIN_LISTEN_ADDR=:18081
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONSTELLATION_LOG_LEVEL=debug
# JSON so Alloy -> Loki can parse the lines (| json); text/console is the default under CONSTELLATION_DEV_MODE.
CONSTELLATION_LOG_FORMAT=json
CONSTELLATION_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# constellation-scanner (tools such as trivy/grype/syft must be on PATH for real scans). The
# scanner authenticates with a scanner token minted by the API; set SCANNER_TOKEN in
# .env.dev.local once you have issued one (POST /api/v1/scanner-tokens), otherwise it polls
# unauthenticated and logs 401s.
CONSTELLATION_API_URL=http://127.0.0.1:18080
CONSTELLATION_CONTROL_PLANE_URL=http://127.0.0.1:18080
SCANNER_LISTEN_ADDR=:18084

# constellation-operator — watches an isolated namespace so a dev operator never fights the
# operator deployed in the cluster. Point KUBECONFIG at the cluster you want to use.
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
OPERATOR_NAMESPACE=constellation-dev
WATCH_NAMESPACE=constellation-dev

# frontend (Vite)
VITE_PORT=5173
VITE_API_URL=http://127.0.0.1:18080

# Seeded admin for the dev loop (constellation-seed)
DEV_ADMIN_EMAIL=admin@demo.test
DEV_ADMIN_PASSWORD=Constellation!1

# Column-encryption key set for the dev loop only (internal/crypto; chart installs mint their own).
CONSTELLATION_AGE_KEY=AGE-SECRET-KEY-14LRZKKVJ2PN7LU6DZ9R8DVY3S75337VLXYDJQ9TN5R3R4EL3Q6YSZTK2ML
