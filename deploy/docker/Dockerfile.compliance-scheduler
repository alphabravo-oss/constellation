# syntax=docker/dockerfile:1.7
# Standalone scheduled-report worker with pinned offline signing tool.
# GO_VERSION has NO default: the Makefile passes --build-arg GO_VERSION from go.mod
# (make check-go-version enforces this). The builder is additionally pinned by
# multi-arch index digest so a Go bump is one value change per file.
# Refresh with: docker buildx imagetools inspect golang:<ver>-bookworm
# Pinned to the 1.27.3-bookworm multi-arch index digest of the Go builder (matches go.mod).
ARG GO_VERSION
ARG GO_IMAGE_DIGEST=sha256:5c3e9b43cfd3bb95c7937462e29d87ada57b481a96fa23ad0eb61778d7a00110
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

FROM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_TIME=
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -tags timetzdata -trimpath -ldflags="-s -w -X github.com/alphabravocompany/constellation/pkg/version.Version=${VERSION} -X github.com/alphabravocompany/constellation/pkg/version.Commit=${COMMIT} -X github.com/alphabravocompany/constellation/pkg/version.BuildTime=${BUILD_TIME}" \
      -o /out/constellation-compliance-scheduler ./cmd/constellation-compliance-scheduler

# Prepare account data without shipping account-management utilities.
RUN mkdir -p /out/home \
 && printf 'root:x:0:0:root:/root:/sbin/nologin\nconstellation:x:10001:10001:Constellation:/home/constellation:/sbin/nologin\n' > /out/passwd \
 && printf 'root:x:0:\nconstellation:x:10001:\n' > /out/group

# Build the same reviewed Cosign source/locks used by the scanner, including
# maintained Azure credentials and Rekor's maintained OpenPGP implementation.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS signing-tool
WORKDIR /src
# In-tree Go rebuild driver (cmd/tools/scanner-tools) over the reviewed locks in
# deploy/docker/scanner-tools; built for the BUILD platform, GOARCH only steers
# the child `go build` of cosign.
COPY go.mod go.sum /src/
COPY cmd/tools/scanner-tools /src/cmd/tools/scanner-tools
COPY deploy/docker/scanner-tools /src/deploy/docker/scanner-tools
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -o /usr/local/bin/scanner-tools ./cmd/tools/scanner-tools \
 && GOARCH=${TARGETARCH} scanner-tools --locks deploy/docker/scanner-tools --tool cosign --work /work --output /tools

FROM ${RUNTIME_IMAGE} AS runtime
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
COPY --from=build /out/passwd /etc/passwd
COPY --from=build /out/group /etc/group
COPY --from=build --chown=10001:10001 /out/home/ /home/constellation/
COPY --from=build /out/constellation-compliance-scheduler /usr/local/bin/constellation-compliance-scheduler
# Include only the reviewed signing binary, not its build environment.
COPY --from=signing-tool /tools/cosign /usr/local/bin/cosign
ENV HOME=/home/constellation
USER 10001:10001
WORKDIR /home/constellation
ENTRYPOINT ["/usr/local/bin/constellation-compliance-scheduler"]
