# Constellation frontend image.
#
# Two stages:
#   1. Build the Vite SPA.
#   2. Serve it with unprivileged nginx on Alpine.
#
# In production the Helm chart wires nginx with the API as an upstream so /api and
# /openapi.json proxy correctly (see deploy/charts/constellation/templates/frontend-deployment.yaml).

# No default on purpose: the Makefile passes NODE_VERSION (single source of truth with
# frontend/package.json engines.node), so a stale default here cannot silently win.
ARG NODE_VERSION
# Official nginx (nginx Inc. unprivileged variant): alpine-based, low-vuln, runs nonroot on
# 8080 out of the box — matches nginx.conf. Off Chainguard per project policy.
# Pinned by multi-arch index digest (stable-alpine as of 2026-10-20); bump deliberately.
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03

# -----------------------------------------------------------------------------
# Stage 1 — build the SPA.
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm AS build
WORKDIR /src

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/. .

# Build metadata stamped into the bundle (see frontend/vite.config.ts `define`).
ARG VERSION=dev
ARG COMMIT=
ARG DATE=
ENV VERSION=${VERSION} COMMIT=${COMMIT} DATE=${DATE}
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2 — serve with nginx.
# -----------------------------------------------------------------------------
FROM ${NGINX_IMAGE} AS runtime

# Refresh fixes released after the base image was published. Keep distribution
# repositories and signature verification; restore the runtime's nonroot UID.
USER 0
RUN apk add --upgrade --no-cache 'libexpat>=2.9.0-r0' 'zlib>=1.3.2-r1' \
    'libx11>=1.8.14-r0' 'libxpm>=3.5.20-r0'
USER 101

COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
# nginx-unprivileged runs as uid 101 (nonroot); USER is numeric above for runAsNonRoot checks.
