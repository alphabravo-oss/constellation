# syntax=docker/dockerfile:1.7
# Constellation runtime-agent image — DaemonSet binary that runs on every node.
#
# The agent observes exec / file events with the in-tree eBPF probes and
# observes network flows + L7 + threats with the vendored NeuVector C
# data-plane (third_party/neuvector/dp). The final image ships:
#
#   /usr/local/bin/constellation-runtime-agent  — Go process (supervisor + ingest)
#   /usr/local/bin/dp                           — NeuVector C data-plane
#   /opt/constellation/runtime.bpf.o            — CO-RE BPF object
#
# Runtime requirements (set on the DaemonSet):
#   privileged: true, hostPID: true, hostNetwork: true
#   capabilities: { NET_ADMIN, SYS_ADMIN, BPF, PERFMON, SYS_PTRACE }
#   hostPath mounts: /sys/fs/bpf, /sys/kernel/btf, /proc → /host/proc
#
# The C dp daemon additionally requires `iptables`, `tc` (iproute2), and
# kernel TC modules (act_mirred, act_pedit) to install the per-pod
# NFQUEUE redirects. AF_PACKET TAP mode is used as a fallback when TC is
# unavailable.

# GO_VERSION has NO default: the Makefile passes --build-arg GO_VERSION from go.mod
# (make check-go-version enforces this). The builder is additionally pinned by
# multi-arch index digest so a Go bump is one value change per file.
# Refresh with: docker buildx imagetools inspect golang:<ver>-bookworm
# Pinned to the 1.27.3-bookworm multi-arch index digest of the Go builder (matches go.mod).
ARG GO_VERSION
ARG GO_IMAGE_DIGEST=sha256:5c3e9b43cfd3bb95c7937462e29d87ada57b481a96fa23ad0eb61778d7a00110
# Debian base for the BPF/dp build stages and the runtime (needs iptables, tc,
# tcpdump and the native dp libraries; see ADR 0005 for why this role is not
# distroless and runs as root). Pinned by index digest; refresh with:
#   docker buildx imagetools inspect debian:bookworm-slim
ARG DEBIAN_TAG=bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ARG CRICTL_VERSION=v1.36.0

# -----------------------------------------------------------------------------
# Stage 1 — Build the BPF CO-RE object (clang + libbpf + bpftool).
# Uses the host-generated vmlinux.h that's already in the source tree (committed
# alongside runtime.bpf.c). We do NOT regenerate it inside docker because BTF
# from a docker build environment doesn't match the host kernel.
# -----------------------------------------------------------------------------
FROM debian:${DEBIAN_TAG} AS bpf-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      clang llvm libbpf-dev make ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY internal/runtime/ebpf/bpf/ /src/bpf/
WORKDIR /src/bpf
# If vmlinux.h is missing, fail loudly — the caller must `make` it on the host first.
RUN test -s vmlinux.h || (echo "vmlinux.h missing — run 'make vmlinux.h' on host" >&2 && exit 1)
RUN make runtime.bpf.o

# -----------------------------------------------------------------------------
# Stage 2 — Build the vendored NeuVector C data-plane (third_party/neuvector/dp).
#
# Build deps mirror NeuVector's package/Dockerfile.enforcer (SUSE BCI), mapped
# to Debian package names:
#   libnetfilter-queue-dev → -lnetfilter_queue (NFQUEUE inline capture)
#   libnfnetlink-dev       → libnfnetlink (transitive)
#   libpcap-dev            → -lpcap          (AF_PACKET TAP fallback)
#   libpcre2-dev           → -lpcre2-8       (DPI parsers regex)
#   libvectorscan-dev      → -lhs            (cross-arch hyperscan; matches NeuVector)
#   libjansson-dev         → -ljansson       (control-plane JSON IPC framing)
#   libjemalloc-dev        → -ljemalloc      (allocator: required by dp linkage)
#   liburcu-dev            → -lurcu -lurcu-cds (RCU hash maps used everywhere)
#   libmnl-dev             → libmnl          (netlink, used by libnetfilter_queue)
#
# `make -C third_party/neuvector/dp` recursively builds utils/, dpi/, dpi/sig/,
# dpi/parsers/ and links the final `dp` binary. The Makefile auto-includes
# ../base.h and ../defs.h — see third_party/neuvector/NOTICE for layout.
# -----------------------------------------------------------------------------
FROM debian:${DEBIAN_TAG} AS dp-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config ca-certificates \
      libpcap-dev libpcre2-dev \
      libnetfilter-queue-dev libnfnetlink-dev libmnl-dev \
      libvectorscan-dev libjansson-dev libjemalloc-dev \
      liburcu-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY third_party/neuvector/ /src/third_party/neuvector/
RUN make -C /src/third_party/neuvector/dp
# Sanity check — fail loudly if the binary isn't produced.
RUN test -x /src/third_party/neuvector/dp/dp || (echo "dp build produced no binary" >&2 && exit 1)

# -----------------------------------------------------------------------------
# Stage 3 — Build the Go agent.
#
# FIPS=1 toggles Go 1.26's bundled FIPS 140-3 module:
#   - GOFIPS140=v1.0.0 selects the validated crypto module
#   - -tags fips enables the pkg/version startup guard
#   - the binary defaults to FIPS mode; a disabled/unpinned runtime is rejected
#
# IMPORTANT scope: this affects the *Go agent's* crypto only. The vendored
# C data-plane (third_party/neuvector/dp) links against hyperscan + PCRE2 +
# jemalloc + urcu — this native stack has not been FIPS-qualified.
# See docs/fips.md for the qualification boundary.
# -----------------------------------------------------------------------------
FROM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_TIME=
ARG FIPS=0
ENV CGO_ENABLED=0 GOOS=linux
RUN if [ "${FIPS}" = "1" ] || [ "${FIPS}" = "true" ]; then \
        echo ">> building Go agent in FIPS 140-3 mode (GOFIPS140=v1.0.0 -tags fips)" >&2 ; \
        GOFIPS140=v1.0.0 go build -trimpath -tags fips \
          -ldflags="-s -w -X github.com/alphabravocompany/constellation/pkg/version.Version=${VERSION}-fips -X github.com/alphabravocompany/constellation/pkg/version.Commit=${COMMIT} -X github.com/alphabravocompany/constellation/pkg/version.BuildTime=${BUILD_TIME}" \
          -o /out/constellation-runtime-agent ./cmd/constellation-runtime-agent ; \
    else \
        go build -trimpath \
          -ldflags="-s -w -X github.com/alphabravocompany/constellation/pkg/version.Version=${VERSION} -X github.com/alphabravocompany/constellation/pkg/version.Commit=${COMMIT} -X github.com/alphabravocompany/constellation/pkg/version.BuildTime=${BUILD_TIME}" \
          -o /out/constellation-runtime-agent ./cmd/constellation-runtime-agent ; \
    fi

# -----------------------------------------------------------------------------
# Stage 4 — Runtime image.
#
# Switched from wolfi-base to debian-slim because the C dp drags in a
# substantial native-lib surface (hyperscan, urcu-cds, jemalloc, libnetfilter_queue)
# and we now need iptables/iproute2/ethtool/tcpdump for the per-pod TC qdisc
# plumbing the agent will install in Wave 3 (CNI integration). Image size
# trades up from ~80MB to ~250MB; that's the cost of running an inline
# data-plane.
# -----------------------------------------------------------------------------
# crictl download stage — keeps curl (and its libcurl/libssh2 CVE surface) OUT of the
# runtime image. crictl is the upstream Kubernetes CRI debug CLI used by the host-container
# inventory collector (internal/runtime/hostscan/containers.go). Pinned + sha256-verified.
FROM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS crictl-build
# Third-party Go CLIs rebuilt on the go.mod toolchain with current x/* modules
# (deploy/docker/go-tools/go.mod); upstream release binaries embed stale ones.
WORKDIR /go-tools
COPY deploy/docker/go-tools/ ./
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS="-trimpath -mod=readonly"
ARG CRICTL_VERSION
RUN go build -ldflags="-s -w -X sigs.k8s.io/cri-tools/pkg/version.Version=${CRICTL_VERSION}" \
      -o /usr/local/bin/crictl sigs.k8s.io/cri-tools/cmd/crictl \
 && /usr/local/bin/crictl --version

FROM debian:${DEBIAN_TAG} AS runtime
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
# Only the packages the agent + dp actually need at runtime. Notably NO bpftool: it's a
# build-time codegen tool (bpf/Makefile → vmlinux.h) and dragged in ~570 CVEs; the agent
# loads its BPF object at runtime via the pure-Go cilium/ebpf library, not the CLI. NO curl
# either — crictl is downloaded in the stage above and copied in.
RUN apt-get update && apt-get upgrade -y --no-install-recommends && apt-get install -y --no-install-recommends \
      ca-certificates tzdata \
      iproute2 iptables conntrack ethtool tcpdump kmod procps \
      libpcap0.8 libpcre2-8-0 \
      libnetfilter-queue1 libnfnetlink0 libmnl0 \
      libvectorscan5 libjansson4 libjemalloc2 \
      liburcu8 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=crictl-build /usr/local/bin/crictl                        /usr/local/bin/crictl
COPY --from=go-build  /out/constellation-runtime-agent              /usr/local/bin/constellation-runtime-agent
COPY --from=bpf-build /src/bpf/runtime.bpf.o                        /opt/constellation/runtime.bpf.o
COPY --from=dp-build  /src/third_party/neuvector/dp/dp              /usr/local/bin/dp

ENV CONSTELLATION_BPF_OBJ=/opt/constellation/runtime.bpf.o
ENV CONSTELLATION_DP_BIN=/usr/local/bin/dp

# FIPS posture is carried into the runtime stage as an OCI label so that
# `docker inspect` can report the requested build mode. The tagged binary
# rejects a disabled/unpinned module before main; labels are not runtime
# attestation. The dp side keeps its own scope; see docs/fips.md.
ARG FIPS=0
ENV CONSTELLATION_FIPS_GO=${FIPS}
LABEL org.alphabravo.constellation.fips.go="${FIPS}" \
      org.alphabravo.constellation.fips.dp="false" \
      org.alphabravo.constellation.fips.scope="see docs/fips.md#runtime-agent"
# The Go 1.26 FIPS module is selected at *build time* by -tags fips +
# GOFIPS140=v1.0.0 (stage 3 above); the binary then enters FIPS mode on
# startup without needing GODEBUG. We write a marker file for operators
# who want to confirm via the filesystem instead of `go version -m`.
RUN mkdir -p /etc/constellation \
 && if [ "${FIPS}" = "1" ] || [ "${FIPS}" = "true" ]; then \
        printf 'fips140=on\nbuilt_with=-tags fips GOFIPS140=v1.0.0\n' > /etc/constellation/fips ; \
    fi

# Runs as root (uid 0) — the ONE deliberate exception to the numeric non-root
# rule (ADR 0005): BPF program loads + LSM attach require CAP_BPF + CAP_PERFMON +
# CAP_SYS_ADMIN, AND the C dp needs CAP_NET_ADMIN for NFQUEUE + TC qdisc
# installation. On most kernels this still requires uid 0 even with an explicit
# capabilities.add list. Stated numerically so the intent is auditable.
USER 0:0
ENTRYPOINT ["/usr/local/bin/constellation-runtime-agent"]
