# syntax=docker/dockerfile:1.7
# Constellation FIPS 140-3 build.
#
# Customer baseline: FedRAMP Moderate, DoD STIG, FIPS-validated TLS + KDF + crypto path.
# The image enables Go's bundled FIPS 140-3 module (GOFIPS140=v1.0.0 + -tags fips) and
# uses Chainguard's wolfi-fips base for the FIPS-validated OpenSSL provider.

ARG GO_VERSION=1.26
ARG WOLFI_FIPS_IMAGE=cgr.dev/chainguard/wolfi-base@sha256:34977aa13765da89f60fee8fe5230e2bb1c55192df08e383c58221ee0d1277fb

FROM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ENV CGO_ENABLED=0 GOOS=linux GOFIPS140=v1.0.0
RUN go build -trimpath -tags fips \
      -ldflags="-s -w -X main.version=${VERSION}-fips" \
      -o /out/constellation-api ./cmd/constellation-api

FROM ${WOLFI_FIPS_IMAGE} AS runtime
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/constellation-api /usr/local/bin/constellation-api
RUN addgroup -S -g 10001 constellation && adduser -S -u 10001 -G constellation constellation
USER 10001:10001
ENV GODEBUG=fips140=on
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/constellation-api"]
