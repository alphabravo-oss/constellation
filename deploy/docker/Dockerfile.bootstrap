# syntax=docker/dockerfile:1.7
# constellation-bootstrap — one-shot post-install image that mints the
# initial admin org + user. See cmd/constellation-bootstrap/main.go for
# behaviour (idempotent: re-running on an already-bootstrapped org is a
# no-op).

# GO_VERSION has NO default: the Makefile passes --build-arg GO_VERSION from go.mod
# (make check-go-version enforces this). The builder is additionally pinned by
# multi-arch index digest so a Go bump is one value change per file.
# Refresh with: docker buildx imagetools inspect golang:<ver>-bookworm
# Pinned to the 1.27.3-bookworm multi-arch index digest of the Go builder (matches go.mod).
ARG GO_VERSION
ARG GO_IMAGE_DIGEST=sha256:5c3e9b43cfd3bb95c7937462e29d87ada57b481a96fa23ad0eb61778d7a00110
# Same digest-pinned distroless static base as the other Go roles.
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

FROM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_TIME=
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -tags timetzdata -trimpath -ldflags="-s -w -X main.version=${VERSION} -X github.com/alphabravocompany/constellation/pkg/version.Version=${VERSION} -X github.com/alphabravocompany/constellation/pkg/version.Commit=${COMMIT} -X github.com/alphabravocompany/constellation/pkg/version.BuildTime=${BUILD_TIME}" \
      -o /out/constellation-bootstrap ./cmd/constellation-bootstrap

FROM ${RUNTIME_IMAGE} AS runtime
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
COPY --from=build /out/constellation-bootstrap /usr/local/bin/constellation-bootstrap
# distroless "nonroot" UID/GID, stated numerically so runAsNonRoot can verify it.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/constellation-bootstrap"]
