# syntax=docker/dockerfile:1.7
# Constellation scanner worker image.
#
# This is the BIG image — bundles syft + trivy + grype + cosign + oras CLIs alongside the
# Go scanner worker. Scales horizontally by scan-job queue depth. Each pod owns a CPU/memory
# budget tuned for trivy DB loads (~1 GB RAM, ~1 CPU per concurrent scan).

# GO_VERSION has NO default: the Makefile passes --build-arg GO_VERSION from go.mod
# (make check-go-version enforces this). The builder is additionally pinned by
# multi-arch index digest so a Go bump is one value change per file.
# Refresh with: docker buildx imagetools inspect golang:<ver>-bookworm
# Pinned to the 1.27.3-bookworm multi-arch index digest of the Go builder (matches go.mod).
ARG GO_VERSION
ARG GO_IMAGE_DIGEST=sha256:5c3e9b43cfd3bb95c7937462e29d87ada57b481a96fa23ad0eb61778d7a00110
ARG TRIVY_VERSION=0.76.0
ARG ORAS_VERSION=1.3.5
# Tag commits, verified after clone (a moved tag fails the build).
ARG TRIVY_COMMIT=531360e5d2a88e732373f1614ba99a38738538b8
ARG ORAS_COMMIT=d6e7b583b9afc7fa3798de77181c53c94418d727
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087

# -----------------------------------------------------------------------------
# Build the Go binary.
# -----------------------------------------------------------------------------
FROM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_TIME=
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -tags timetzdata -trimpath -ldflags="-s -w -X github.com/alphabravocompany/constellation/pkg/version.Version=${VERSION} -X github.com/alphabravocompany/constellation/pkg/version.Commit=${COMMIT} -X github.com/alphabravocompany/constellation/pkg/version.BuildTime=${BUILD_TIME}" \
      -o /out/constellation-scanner ./cmd/constellation-scanner

# -----------------------------------------------------------------------------
# Rebuild tools whose upstream binaries still embed vulnerable Go dependencies.
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS patched-tools
WORKDIR /src
# The rebuild driver is the in-tree Go tool (cmd/tools/scanner-tools); it reads
# the reviewed source locks under deploy/docker/scanner-tools. It is compiled for
# the BUILD platform and only its child `go build`s honour GOARCH, so it is
# built first rather than `go run` under a foreign GOARCH.
COPY go.mod go.sum /src/
COPY cmd/tools/scanner-tools /src/cmd/tools/scanner-tools
COPY deploy/docker/scanner-tools /src/deploy/docker/scanner-tools
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -o /usr/local/bin/scanner-tools ./cmd/tools/scanner-tools \
 && GOARCH=${TARGETARCH} scanner-tools --locks deploy/docker/scanner-tools --work /work --output /tools

# Other tools retain checksum-verified upstream binaries.
# Shell-equipped stage that only downloads/verifies upstream tools (ADR 0005);
# nothing from it ships except the verified binaries. Refresh with:
#   docker buildx imagetools inspect debian:bookworm-slim
# Trivy and ORAS: upstream release binaries are built with go1.27.2 / go1.26.9, and
# go < 1.27.3 accepts the compromised eMudhra intermediate chain. Rebuild both from
# their verified tag commits on the go.mod toolchain (GOTOOLCHAIN=local: never auto-
# download another Go). scripts/check-image-go.sh enforces the floor on every image.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS upstream-tools
ARG TARGETARCH
ARG TRIVY_VERSION
ARG TRIVY_COMMIT
ARG ORAS_VERSION
ARG ORAS_COMMIT
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    git clone -q --depth 1 --branch "v${TRIVY_VERSION}" https://github.com/aquasecurity/trivy /src/trivy \
 && test "$(git -C /src/trivy rev-parse HEAD)" = "${TRIVY_COMMIT}" \
 && cd /src/trivy && GOARCH=${TARGETARCH} go build -ldflags "-s -w -X github.com/aquasecurity/trivy/pkg/version/app.ver=${TRIVY_VERSION}" -o /tools/trivy ./cmd/trivy
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    git clone -q --depth 1 --branch "v${ORAS_VERSION}" https://github.com/oras-project/oras /src/oras \
 && test "$(git -C /src/oras rev-parse HEAD)" = "${ORAS_COMMIT}" \
 && cd /src/oras && GOARCH=${TARGETARCH} go build -ldflags "-s -w -X oras.land/oras/internal/version.Version=${ORAS_VERSION} -X oras.land/oras/internal/version.BuildMetadata= -X oras.land/oras/internal/version.GitCommit=${ORAS_COMMIT} -X oras.land/oras/internal/version.GitTreeState=clean" -o /tools/oras ./cmd/oras

FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8 AS tools
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /tools
COPY --from=upstream-tools /tools/ /tools/
COPY --from=patched-tools /tools/ /tools/

RUN /tools/syft --version >/dev/null \
 && /tools/grype --version >/dev/null \
 && /tools/trivy --version >/dev/null \
 && /tools/cosign version  >/dev/null \
 && /tools/oras   version  >/dev/null

# Optional offline DB preparation happens in a shell-equipped build stage.
# Fail the air-gap build if either database cannot be fetched.
FROM tools AS databases
RUN mkdir -p /out/home/.cache \
 && printf 'root:x:0:0:root:/root:/sbin/nologin\nconstellation:x:10001:10001:Constellation:/home/constellation:/sbin/nologin\n' > /out/passwd \
 && printf 'root:x:0:\nconstellation:x:10001:\n' > /out/group
ARG BAKE_VULN_DB=0
RUN if [ "$BAKE_VULN_DB" = "1" ]; then \
      TRIVY_CACHE_DIR=/out/home/.cache/trivy /tools/trivy image --download-db-only --quiet \
      && GRYPE_DB_CACHE_DIR=/out/home/.cache/grype/db /tools/grype db update -q; \
    fi

# Static scanner and tools need CA roots/timezones, not a shell or package manager.
FROM ${RUNTIME_IMAGE} AS runtime
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
COPY --from=databases /out/passwd /etc/passwd
COPY --from=databases /out/group /etc/group
COPY --from=databases --chown=10001:10001 /out/home/ /home/constellation/
COPY --from=tools /tools/syft /usr/local/bin/syft
COPY --from=tools /tools/trivy /usr/local/bin/trivy
COPY --from=tools /tools/grype /usr/local/bin/grype
COPY --from=tools /tools/cosign /usr/local/bin/cosign
COPY --from=tools /tools/oras /usr/local/bin/oras
COPY --from=build /out/constellation-scanner /usr/local/bin/constellation-scanner
ENV HOME=/home/constellation
USER 10001:10001
WORKDIR /home/constellation
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/constellation-scanner"]
