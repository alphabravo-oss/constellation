# syntax=docker/dockerfile:1.7
# Constellation scanner worker image.
#
# This is the BIG image — bundles syft + trivy + grype + cosign + oras CLIs alongside the
# Go scanner worker. Scales horizontally by scan-job queue depth. Each pod owns a CPU/memory
# budget tuned for trivy DB loads (~1 GB RAM, ~1 CPU per concurrent scan).

ARG GO_VERSION=1.26
ARG SYFT_VERSION=1.42.2
ARG TRIVY_VERSION=0.69.3
ARG GRYPE_VERSION=0.109.0
ARG COSIGN_VERSION=2.6.1
ARG ORAS_VERSION=1.3.0
ARG SYFT_SHA256_AMD64=1d3cc98b13ce3dfb6083ef42f64f1033e40d7dea292e8ea85ed1cf88efb2f542
ARG SYFT_SHA256_ARM64=49aa164f953adcca6d80d6ce6d2a61d3226be72046a0b3ddd02d9c28c49c916d
ARG TRIVY_SHA256_AMD64=1816b632dfe529869c740c0913e36bd1629cb7688bd5634f4a858c1d57c88b75
ARG TRIVY_SHA256_ARM64=7e3924a974e912e57b4a99f65ece7931f8079584dae12eb7845024f97087bdfd
ARG GRYPE_SHA256_AMD64=c06e79287aa4d7343d7937571cf33154b560cbe483c6897369c53e2970fae647
ARG GRYPE_SHA256_ARM64=c6b58fc8eea0607af6374e88781bfeb5192b0db79d639693cc924925efe22253
ARG COSIGN_SHA256_AMD64=064954c5d8c7e3b28188eee5b1727b31c411550bc5fefd41aa672d3c761d103a
ARG COSIGN_SHA256_ARM64=56a16480bdd56ec789abaa65924402f6b92c0041f06885995853c05567b76f34
ARG ORAS_SHA256_AMD64=6cdc692f929100feb08aa8de584d02f7bcc30ec7d88bc2adc2054d782db57c64
ARG ORAS_SHA256_ARM64=7649738b48fde10542bcc8b0e9b460ba83936c75fb5be01ee6d4443764a14352
ARG WOLFI_IMAGE=cgr.dev/chainguard/wolfi-base@sha256:34977aa13765da89f60fee8fe5230e2bb1c55192df08e383c58221ee0d1277fb

# -----------------------------------------------------------------------------
# Build the Go binary.
# -----------------------------------------------------------------------------
FROM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/constellation-scanner ./cmd/constellation-scanner

# -----------------------------------------------------------------------------
# Fetch upstream scanner binaries.
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS tools
ARG TARGETARCH
ARG SYFT_VERSION
ARG TRIVY_VERSION
ARG GRYPE_VERSION
ARG COSIGN_VERSION
ARG ORAS_VERSION
ARG SYFT_SHA256_AMD64
ARG SYFT_SHA256_ARM64
ARG TRIVY_SHA256_AMD64
ARG TRIVY_SHA256_ARM64
ARG GRYPE_SHA256_AMD64
ARG GRYPE_SHA256_ARM64
ARG COSIGN_SHA256_AMD64
ARG COSIGN_SHA256_ARM64
ARG ORAS_SHA256_AMD64
ARG ORAS_SHA256_ARM64

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates tar \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /tools

RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) \
        SYFT_SHA256="${SYFT_SHA256_AMD64}"; \
        GRYPE_SHA256="${GRYPE_SHA256_AMD64}"; \
        TRIVY_SHA256="${TRIVY_SHA256_AMD64}"; \
        COSIGN_SHA256="${COSIGN_SHA256_AMD64}"; \
        ORAS_SHA256="${ORAS_SHA256_AMD64}"; \
        TRIVY_ARCH=64bit ;; \
      arm64) \
        SYFT_SHA256="${SYFT_SHA256_ARM64}"; \
        GRYPE_SHA256="${GRYPE_SHA256_ARM64}"; \
        TRIVY_SHA256="${TRIVY_SHA256_ARM64}"; \
        COSIGN_SHA256="${COSIGN_SHA256_ARM64}"; \
        ORAS_SHA256="${ORAS_SHA256_ARM64}"; \
        TRIVY_ARCH=ARM64 ;; \
      *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_${TARGETARCH}.tar.gz" -o syft.tar.gz; \
    echo "${SYFT_SHA256}  syft.tar.gz" | sha256sum -c -; \
    tar -xzf syft.tar.gz syft; \
    curl -fsSL "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_${TARGETARCH}.tar.gz" -o grype.tar.gz; \
    echo "${GRYPE_SHA256}  grype.tar.gz" | sha256sum -c -; \
    tar -xzf grype.tar.gz grype; \
    curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-${TRIVY_ARCH}.tar.gz" -o trivy.tar.gz; \
    echo "${TRIVY_SHA256}  trivy.tar.gz" | sha256sum -c -; \
    tar -xzf trivy.tar.gz trivy; \
    curl -fsSL "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${TARGETARCH}" -o cosign; \
    echo "${COSIGN_SHA256}  cosign" | sha256sum -c -; \
    chmod 0755 cosign; \
    curl -fsSL "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_${TARGETARCH}.tar.gz" -o oras.tar.gz; \
    echo "${ORAS_SHA256}  oras.tar.gz" | sha256sum -c -; \
    tar -xzf oras.tar.gz oras; \
    rm -f syft.tar.gz grype.tar.gz trivy.tar.gz oras.tar.gz

RUN /tools/syft --version >/dev/null \
 && /tools/grype --version >/dev/null \
 && /tools/trivy --version >/dev/null \
 && /tools/cosign version  >/dev/null \
 && /tools/oras   version  >/dev/null

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
FROM ${WOLFI_IMAGE} AS runtime
RUN apk add --no-cache ca-certificates tzdata git

COPY --from=tools /tools/syft   /usr/local/bin/syft
COPY --from=tools /tools/trivy  /usr/local/bin/trivy
COPY --from=tools /tools/grype  /usr/local/bin/grype
COPY --from=tools /tools/cosign /usr/local/bin/cosign
COPY --from=tools /tools/oras   /usr/local/bin/oras

COPY --from=build /out/constellation-scanner /usr/local/bin/constellation-scanner

RUN addgroup -S -g 10001 constellation && adduser -S -u 10001 -G constellation -h /home/constellation -s /sbin/nologin constellation

USER 10001:10001
WORKDIR /home/constellation

# BAKE_VULN_DB controls whether the Trivy + Grype vuln DBs are pre-warmed INTO the
# image (~+3.4 GB). Default 0 = SLIM: the DBs are ~stale the moment they're baked,
# and the scanner refreshes them at runtime on startup (dbRefreshLoop), so baking
# them just bloats the image (~4.6 GB) with immediately-outdated data. Set to 1 for
# an AIR-GAPPED image that can scan on first boot with no network (build the
# `-airgap` variant). Air-gapped without a fat image: pre-load DBs + set
# CONSTELLATION_SCANNER_OFFLINE_DB.
ARG BAKE_VULN_DB=0
RUN if [ "$BAKE_VULN_DB" = "1" ]; then \
      echo ">> baking Trivy + Grype vuln DBs into the image (air-gap variant)"; \
      trivy image --download-db-only --quiet || true; \
      grype db update -q || true; \
    else \
      echo ">> slim scanner: vuln DBs fetched at runtime (or pre-loaded for air-gap)"; \
    fi

EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/constellation-scanner"]
