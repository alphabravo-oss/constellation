# syntax=docker/dockerfile:1.7
# Constellation discoverer image.
#
# Long-running per-cluster process that watches a Kubernetes API server, projects
# Deployments/StatefulSets/DaemonSets into the `deployments` table, and rolls up
# finding counts back into each row.
#
# Configuration is fully env-driven (see cmd/constellation-discoverer/main.go):
#   DATABASE_URL, KUBECONFIG, CLUSTER_NAME, ORG_ID, NAMESPACE_FILTER, RECONCILE_INTERVAL.
#
# Compose runs ONE replica per cluster; in K8s the chart fans this out via a Deployment-
# per-managed-cluster pattern.

ARG GO_VERSION=1.26.9
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

FROM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_TIME=
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -tags timetzdata -trimpath -ldflags="-s -w -X github.com/alphabravocompany/constellation/pkg/version.Version=${VERSION} -X github.com/alphabravocompany/constellation/pkg/version.Commit=${COMMIT} -X github.com/alphabravocompany/constellation/pkg/version.BuildTime=${BUILD_TIME}" \
      -o /out/constellation-discoverer ./cmd/constellation-discoverer

# Prepare account data without shipping account-management utilities.
RUN mkdir -p /out/home \
 && printf 'root:x:0:0:root:/root:/sbin/nologin\nconstellation:x:10001:10001:Constellation:/home/constellation:/sbin/nologin\n' > /out/passwd \
 && printf 'root:x:0:\nconstellation:x:10001:\n' > /out/group

FROM ${RUNTIME_IMAGE} AS runtime
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
COPY --from=build /out/passwd /etc/passwd
COPY --from=build /out/group /etc/group
COPY --from=build --chown=10001:10001 /out/home/ /home/constellation/
COPY --from=build /out/constellation-discoverer /usr/local/bin/constellation-discoverer
ENV HOME=/home/constellation
USER 10001:10001
WORKDIR /home/constellation
ENTRYPOINT ["/usr/local/bin/constellation-discoverer"]
