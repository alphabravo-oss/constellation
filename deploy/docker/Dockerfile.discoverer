# syntax=docker/dockerfile:1.7
# Constellation discoverer image.
#
# Long-running per-cluster process that watches a Kubernetes API server, projects
# Deployments/StatefulSets/DaemonSets into the `deployments` table, and rolls up
# finding counts back into each row.
#
# Configuration is fully env-driven (see cmd/constellation-discoverer/main.go):
#   DATABASE_URL, KUBECONFIG, CLUSTER_NAME, ORG_ID, NAMESPACE_FILTER, RECONCILE_INTERVAL.
#
# Compose runs ONE replica per cluster; in K8s the chart fans this out via a Deployment-
# per-managed-cluster pattern.

ARG GO_VERSION=1.26.9
ARG RUNTIME_IMAGE=debian:bookworm-slim

FROM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_TIME=
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath -ldflags="-s -w -X github.com/alphabravocompany/constellation/pkg/version.Version=${VERSION} -X github.com/alphabravocompany/constellation/pkg/version.Commit=${COMMIT} -X github.com/alphabravocompany/constellation/pkg/version.BuildTime=${BUILD_TIME}" \
      -o /out/constellation-discoverer ./cmd/constellation-discoverer

FROM ${RUNTIME_IMAGE} AS runtime
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/constellation-discoverer /usr/local/bin/constellation-discoverer
RUN groupadd -r constellation && useradd -r -g constellation -m -d /home/constellation -s /usr/sbin/nologin constellation
USER constellation
WORKDIR /home/constellation
ENTRYPOINT ["/usr/local/bin/constellation-discoverer"]
