# syntax=docker/dockerfile:1.7
# Constellation audit archiver image — CronJob target.
#
# Runs every 6h by default (operator-managed CronJob). Walks the audit chain, verifies
# integrity, freezes the rolling window to S3, and signs the manifest with cosign.

# GO_VERSION has NO default: the Makefile passes --build-arg GO_VERSION from go.mod
# (make check-go-version enforces this). The builder is additionally pinned by
# multi-arch index digest so a Go bump is one value change per file.
# Refresh with: docker buildx imagetools inspect golang:<ver>-bookworm
# Pinned to the 1.27.3-bookworm multi-arch index digest of the Go builder (matches go.mod).
ARG GO_VERSION
ARG GO_IMAGE_DIGEST=sha256:5c3e9b43cfd3bb95c7937462e29d87ada57b481a96fa23ad0eb61778d7a00110
# Debian runtime (bundles the cosign tool; see ADR 0005 for why this role is not
# distroless). Pinned by index digest; refresh with:
#   docker buildx imagetools inspect debian:bookworm-slim
ARG DEBIAN_IMAGE=debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ARG RUNTIME_IMAGE=debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

FROM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/audit-archiver ./cmd/audit-archiver

# cosign: the same patched source build the scanner image ships
# (deploy/docker/scanner-tools: upstream v3.1.3 rebuilt on the go.mod toolchain).
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS cosign
WORKDIR /src
COPY go.mod go.sum /src/
COPY cmd/tools/scanner-tools /src/cmd/tools/scanner-tools
COPY deploy/docker/scanner-tools /src/deploy/docker/scanner-tools
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -o /usr/local/bin/scanner-tools ./cmd/tools/scanner-tools \
 && GOARCH=${TARGETARCH} scanner-tools --locks deploy/docker/scanner-tools --work /work --output /tools --tool cosign \
 && cp /tools/cosign /cosign

FROM ${RUNTIME_IMAGE} AS runtime
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*
COPY --from=cosign /cosign /usr/local/bin/cosign
COPY --from=build  /out/audit-archiver /usr/local/bin/audit-archiver
RUN groupadd -r -g 10001 constellation && useradd -r -u 10001 -g constellation constellation
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/audit-archiver"]
