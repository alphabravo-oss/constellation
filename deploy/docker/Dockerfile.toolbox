# syntax=docker/dockerfile:1.7
# Purpose-built operator toolbox: age + kubectl + rclone, non-root. Used by the
# chart's age-key bootstrap hook, the off-host archive sync and the secrets-backup
# CronJob instead of `apk add` at runtime (no package manager, no network,
# pinned versions). age and kubectl are rebuilt from source on the go.mod Go
# toolchain with current golang.org/x modules (deploy/docker/go-tools/go.mod) because
# the upstream release binaries carry stale stdlib/x CVEs; rclone is the current
# upstream release. The release gate (cmd/tools/release-gate) scans every bundled
# binary, so bump deploy/docker/go-tools/go.mod with the Go toolchain.
# Refresh digests with: docker buildx imagetools inspect <image:tag>
ARG GO_VERSION
ARG GO_IMAGE_DIGEST=sha256:5c3e9b43cfd3bb95c7937462e29d87ada57b481a96fa23ad0eb61778d7a00110
ARG ALPINE_DIGEST=sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

FROM golang:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS tools
ARG KUBECTL_VERSION=v1.37.1
WORKDIR /src
COPY deploy/docker/go-tools/ ./
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
RUN go build -ldflags="-s -w" -o /out/age filippo.io/age/cmd/age \
 && go build -ldflags="-s -w" -o /out/age-keygen filippo.io/age/cmd/age-keygen \
 && go build -ldflags="-s -w -X k8s.io/client-go/pkg/version.gitVersion=${KUBECTL_VERSION} -X k8s.io/component-base/version.gitVersion=${KUBECTL_VERSION}" -o /out/kubectl ./kubectl \
 && /out/kubectl version --client >/dev/null && /out/age --version >/dev/null

FROM alpine:3.24@${ALPINE_DIGEST} AS fetch
ARG RCLONE_VERSION=v1.75.2
ARG TARGETARCH=amd64
RUN apk add --no-cache curl ca-certificates \
 && curl -fsSL "https://downloads.rclone.org/${RCLONE_VERSION}/rclone-${RCLONE_VERSION}-linux-${TARGETARCH}.zip" -o /tmp/rclone.zip \
 && unzip -q /tmp/rclone.zip -d /tmp && install -m 0755 /tmp/rclone-*/rclone /usr/local/bin/rclone

FROM alpine:3.24@${ALPINE_DIGEST}
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates \
 && adduser -D -u 10001 toolbox
COPY --from=fetch /usr/local/bin/rclone /usr/local/bin/
COPY --from=tools /out/kubectl /out/age /out/age-keygen /usr/local/bin/
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.title="constellation-toolbox" \
      org.opencontainers.image.description="age + kubectl + rclone for chart hooks, off-host sync and the secrets-backup CronJob" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
USER 10001:10001
ENTRYPOINT ["/bin/sh"]
