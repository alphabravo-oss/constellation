# syntax=docker/dockerfile:1.7
# Purpose-built operator toolbox: age + kubectl + rclone, non-root. Used by the
# chart's age-key bootstrap hook and the secrets-backup CronJob instead of
# `apk add` at runtime (no package manager, no network, pinned versions).
# Refresh digests with: docker buildx imagetools inspect <image:tag>
ARG ALPINE_DIGEST=sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
FROM alpine:3.24@${ALPINE_DIGEST} AS fetch
ARG KUBECTL_VERSION=v1.35.5
ARG AGE_VERSION=v1.3.2
ARG RCLONE_VERSION=v1.72.1
ARG TARGETARCH=amd64
RUN apk add --no-cache curl ca-certificates \
 && curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" -o /usr/local/bin/kubectl \
 && curl -fsSL "https://github.com/FiloSottile/age/releases/download/${AGE_VERSION}/age-${AGE_VERSION}-linux-${TARGETARCH}.tar.gz" | tar -xz -C /tmp \
 && install -m 0755 /tmp/age/age /tmp/age/age-keygen /usr/local/bin/ \
 && curl -fsSL "https://downloads.rclone.org/${RCLONE_VERSION}/rclone-${RCLONE_VERSION}-linux-${TARGETARCH}.zip" -o /tmp/rclone.zip \
 && unzip -q /tmp/rclone.zip -d /tmp && install -m 0755 /tmp/rclone-*/rclone /usr/local/bin/rclone \
 && chmod 0755 /usr/local/bin/kubectl

FROM alpine:3.24@${ALPINE_DIGEST}
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates \
 && adduser -D -u 10001 toolbox
COPY --from=fetch /usr/local/bin/kubectl /usr/local/bin/age /usr/local/bin/age-keygen /usr/local/bin/rclone /usr/local/bin/
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.title="constellation-toolbox" \
      org.opencontainers.image.description="age + kubectl + rclone for chart hooks and the secrets-backup CronJob" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
USER 10001:10001
ENTRYPOINT ["/bin/sh"]
