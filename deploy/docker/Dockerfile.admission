# syntax=docker/dockerfile:1.7
# Constellation admission webhook image.
#
# Stateless ValidatingWebhook target. 2-3 replicas behind a Service; TLS material is
# mounted at /etc/webhook/certs (cert-manager Certificate or operator-bootstrapped).

ARG GO_VERSION=1.26.9
ARG RUNTIME_IMAGE=debian:bookworm-slim

FROM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_TIME=
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath -ldflags="-s -w -X github.com/alphabravocompany/constellation/pkg/version.Version=${VERSION} -X github.com/alphabravocompany/constellation/pkg/version.Commit=${COMMIT} -X github.com/alphabravocompany/constellation/pkg/version.BuildTime=${BUILD_TIME}" \
      -o /out/constellation-admission ./cmd/constellation-admission

FROM ${RUNTIME_IMAGE} AS runtime
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/constellation-admission /usr/local/bin/constellation-admission
RUN groupadd -r -g 10001 constellation && useradd -r -u 10001 -g constellation constellation
USER 10001:10001
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/constellation-admission"]
