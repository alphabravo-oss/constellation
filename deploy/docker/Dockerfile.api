# syntax=docker/dockerfile:1.7
# Constellation control-plane API image.
#
# Scales 2-3 replicas behind a Service for HA. Does NOT bundle syft/trivy/grype — those
# live in the scanner image, which receives jobs over HTTP from this API.

ARG GO_VERSION=1.26
ARG RUNTIME_IMAGE=debian:bookworm-slim

# -----------------------------------------------------------------------------
# Build
# -----------------------------------------------------------------------------
FROM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/constellation-api ./cmd/constellation-api \
 && go build -trimpath -ldflags="-s -w" -o /out/constellationctl ./cmd/constellationctl

# -----------------------------------------------------------------------------
# Runtime — minimal debian-slim, no scanner CLIs. (Off Chainguard per project policy.)
# -----------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -r -g 10001 constellation \
 && useradd -r -u 10001 -g constellation -m -d /home/constellation -s /usr/sbin/nologin constellation
COPY --from=build /out/constellation-api /usr/local/bin/constellation-api
COPY --from=build /out/constellationctl  /usr/local/bin/constellationctl
USER 10001:10001
WORKDIR /home/constellation
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/constellation-api"]
