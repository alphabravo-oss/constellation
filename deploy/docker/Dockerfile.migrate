# Rebuild Goose with reviewed locks and only the PostgreSQL driver used here.
# Source archive identity is checked independently of the patched dependency locks.
FROM golang:1.26.9-bookworm AS goose
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOWORK=off
WORKDIR /tmp/source
RUN go mod download github.com/pressly/goose/v3@v3.27.1 \
 && test "$(cat /go/pkg/mod/cache/download/github.com/pressly/goose/v3/@v/v3.27.1.ziphash)" = 'h1:6uEvcprBybDmW4hcz3gYujhARhye+GoWKhEWyzD5sh4=' \
 && cp -a /go/pkg/mod/github.com/pressly/goose/v3@v3.27.1 /src \
 && chmod -R u+w /src
WORKDIR /src
COPY deploy/docker/goose/go.mod deploy/docker/goose/go.sum ./
RUN go build -mod=readonly -trimpath \
    -tags no_clickhouse,no_mssql,no_mysql,no_sqlite3,no_libsql,no_vertica,no_ydb \
    -ldflags='-s -w' -o /out/goose ./cmd/goose

# Supported, digest-pinned runtime. Preserve shell/psql compatibility for operators.
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk upgrade --no-cache \
 && apk add --no-cache postgresql-client ca-certificates 'zlib>=1.3.2-r1'
COPY --from=goose /out/goose /usr/local/bin/goose
COPY db/migrations/ /migrations/
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
USER 10001:10001
ENTRYPOINT ["/bin/sh","-c","GOOSE_DRIVER=postgres GOOSE_DBSTRING=\"$DATABASE_URL\" GOOSE_MIGRATION_DIR=/migrations goose up"]
