# Add migrations to the already deployed, reviewed development migration runtime.
# This preserves its toolchain and packages during the scanner lease upgrade.
# The tagged release still builds deploy/docker/Dockerfile.migrate independently.
FROM ghcr.io/alphabravo-oss/constellation/migrate@sha256:6abc8c6581f88021124d263b17dd80219a906a8523e4ceb744cd4655192fd1d8
COPY db/migrations/ /migrations/
ARG VERSION=dev
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
