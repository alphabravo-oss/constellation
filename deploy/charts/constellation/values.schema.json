{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Constellation configuration",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "systemProtection": {
      "type": "object",
      "properties": {
        "protectedNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "uniqueItems": true
        }
      }
    },
    "highAvailability": {
      "title": "High availability",
      "description": "Spread replicated control-plane workloads across nodes and protect them with disruption budgets.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable high availability",
          "default": false
        },
        "topologyKey": {
          "type": "string",
          "title": "Topology key",
          "default": "kubernetes.io/hostname"
        },
        "whenUnsatisfiable": {
          "type": "string",
          "title": "Scheduling policy",
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ],
          "default": "DoNotSchedule"
        }
      }
    },
    "networkPolicies": {
      "title": "Network policies",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable namespace network policies",
          "default": false
        }
      }
    },
    "api": {
      "title": "API",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicas": {
          "type": "integer",
          "title": "API replicas",
          "minimum": 1,
          "maximum": 20,
          "default": 2
        },
        "partitionStatisticsMaintenanceEnabled": {
          "type": "boolean",
          "title": "Maintain partitioned parent statistics",
          "default": true
        },
        "supportBundleSigningKeySecret": {
          "type": "string",
          "title": "Existing support-bundle signing key Secret",
          "default": ""
        },
        "supportBundleSigningKeySecretKey": {
          "type": "string",
          "title": "Signing key field in Secret",
          "minLength": 1,
          "default": "private-key.pem"
        },
        "pcapStorage": {
          "type": "object",
          "title": "Durable packet capture storage",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "retentionEnabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable bounded expiry only on this verified single-RWO or shared-RWX claim"
            },
            "existingClaim": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
              "default": ""
            },
            "accessMode": {
              "type": "string",
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany"
              ],
              "default": "ReadWriteOnce"
            }
          },
          "required": [
            "enabled",
            "existingClaim",
            "accessMode"
          ]
        },
        "leaderElection": {
          "type": "object",
          "title": "Leader election",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable leader election",
              "default": true
            }
          }
        },
        "metrics": {
          "type": "object",
          "title": "Metrics exposure (admin listener :9090)",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "boolean",
              "title": "Add prometheus.io/* pod annotations",
              "default": true
            },
            "serviceMonitor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "title": "Render a Prometheus Operator ServiceMonitor",
                  "default": false
                },
                "interval": {
                  "type": "string",
                  "default": "30s"
                },
                "scrapeTimeout": {
                  "type": "string",
                  "default": "10s"
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "namespace": {
                  "type": "string",
                  "default": ""
                }
              }
            },
            "allowFrom": {
              "type": "object",
              "title": "namespaceSelector labels admitted to the admin port by NetworkPolicy",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "operator": {
      "title": "Operator",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicas": {
          "type": "integer",
          "title": "Operator replicas",
          "minimum": 1,
          "maximum": 5,
          "default": 1
        },
        "leaderElection": {
          "type": "object",
          "title": "Leader election",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable leader election",
              "default": true
            }
          }
        }
      }
    },
    "scanner": {
      "title": "Image and SBOM scanning",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable scanners",
          "default": true
        },
        "replicas": {
          "type": "integer",
          "title": "Scanner replicas",
          "minimum": 1,
          "maximum": 50,
          "default": 2
        },
        "maxConcurrent": {
          "type": "integer",
          "title": "Concurrent scans per replica",
          "minimum": 0,
          "maximum": 64,
          "default": 1
        },
        "cache": {
          "type": "object",
          "title": "Scanner cache",
          "additionalProperties": true,
          "properties": {
            "persistent": {
              "type": "boolean",
              "title": "Persist scanner caches",
              "default": true
            },
            "size": {
              "type": "string",
              "title": "Cache volume size",
              "default": "8Gi",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string",
              "title": "Storage class",
              "default": ""
            }
          }
        },
        "engines": {
          "type": "object",
          "title": "Scanning engines",
          "additionalProperties": true,
          "properties": {
            "syft": {
              "type": "boolean",
              "title": "Syft SBOM inventory",
              "default": true
            },
            "trivy": {
              "type": "boolean",
              "title": "Trivy analysis",
              "default": true
            },
            "grype": {
              "type": "boolean",
              "title": "Grype analysis",
              "default": true
            }
          }
        },
        "registryConfigSecret": {
          "type": "string",
          "title": "Registry pull configuration Secret for discovered images",
          "default": ""
        }
      }
    },
    "runtimeAgent": {
      "title": "Runtime protection",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "execDryRun": {
          "type": "boolean",
          "title": "Execution enforcer dry run",
          "description": "Optional override. When omitted, preserve the agent default. Explicit true and false are both supported."
        },
        "enabled": {
          "type": "boolean",
          "title": "Enable the runtime agent",
          "default": true
        },
        "enforcement": {
          "type": "object",
          "title": "Enforcement",
          "additionalProperties": true,
          "properties": {
            "mode": {
              "type": "string",
              "title": "Default mode",
              "enum": [
                "disabled",
                "monitor",
                "protect"
              ],
              "default": "monitor"
            },
            "process": {
              "type": "boolean",
              "title": "Process enforcement",
              "default": true
            },
            "file": {
              "type": "boolean",
              "title": "File enforcement",
              "default": true
            },
            "exec": {
              "type": "boolean",
              "title": "Executable integrity enforcement",
              "default": true
            },
            "network": {
              "type": "boolean",
              "title": "Inline network enforcement",
              "description": "High-impact option. Only labeled workloads enter the fail-open NFQUEUE path.",
              "default": false
            },
            "dpi": {
              "type": "boolean",
              "title": "Inline WAF/DLP enforcement",
              "description": "Requires protect mode and inline network enforcement.",
              "default": false
            }
          }
        }
      }
    },
    "admission": {
      "title": "Admission control",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable admission service",
          "default": true
        },
        "replicas": {
          "type": "integer",
          "title": "Admission replicas",
          "minimum": 1,
          "maximum": 20,
          "default": 2
        },
        "webhook": {
          "type": "object",
          "title": "Validating webhook",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Register validating webhook",
              "default": true
            },
            "failurePolicy": {
              "type": "string",
              "title": "Failure policy",
              "enum": [
                "Ignore",
                "Fail"
              ],
              "default": "Ignore"
            },
            "timeoutSeconds": {
              "type": "integer",
              "title": "Timeout seconds",
              "minimum": 1,
              "maximum": 30,
              "default": 5
            }
          }
        }
      }
    },
    "frontend": {
      "title": "Web console",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicas": {
          "type": "integer",
          "title": "Frontend replicas",
          "minimum": 1,
          "maximum": 20,
          "default": 2
        }
      }
    },
    "ingress": {
      "title": "Ingress",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Create an Ingress",
          "default": false
        },
        "className": {
          "type": "string",
          "title": "Ingress class",
          "default": ""
        },
        "host": {
          "type": "string",
          "title": "Hostname",
          "default": "constellation.example.com"
        },
        "tls": {
          "type": "object",
          "title": "Ingress TLS",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable TLS",
              "default": false
            },
            "secretName": {
              "type": "string",
              "title": "TLS Secret",
              "default": "constellation-frontend-tls"
            }
          }
        }
      }
    },
    "postgres": {
      "title": "PostgreSQL",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string",
          "title": "Database mode",
          "description": "cnpg (CloudNativePG in-cluster, default) or external (operator-supplied DSN). Empty derives from cloudnativepg.enabled.",
          "enum": [
            "",
            "cnpg",
            "external"
          ],
          "default": "cnpg"
        },
        "dsn": {
          "type": "string",
          "title": "External database URL",
          "description": "Prefer an existing Secret for production credentials.",
          "default": ""
        },
        "existingSecret": {
          "type": "string",
          "title": "External database Secret",
          "default": ""
        },
        "cloudnativepg": {
          "type": "object",
          "title": "CloudNativePG",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable CloudNativePG",
              "description": "Only consulted when postgres.mode is empty.",
              "default": true
            },
            "instances": {
              "type": "integer",
              "title": "PostgreSQL instances",
              "minimum": 1,
              "maximum": 9,
              "default": 3
            },
            "imageName": {
              "type": "string",
              "title": "pgvector-enabled operand image",
              "default": "ghcr.io/alphabravo-oss/constellation/postgres:16.15-v0.3.0"
            },
            "storage": {
              "type": "string",
              "title": "Volume size per instance",
              "default": "20Gi",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string",
              "title": "Storage class",
              "default": ""
            },
            "barmanCloud": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "pluginName": {
                  "type": "string",
                  "minLength": 1
                },
                "objectStoreName": {
                  "type": "string"
                },
                "recovery": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "sourceName": {
                      "type": "string",
                      "minLength": 1
                    },
                    "objectStoreName": {
                      "type": "string"
                    },
                    "serverName": {
                      "type": "string"
                    },
                    "targetTime": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "scheduledBackup": {
              "type": "object",
              "title": "Scheduled backup",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "title": "Enable scheduled backups",
                  "default": false
                },
                "schedule": {
                  "type": "string",
                  "title": "CNPG six-field cron schedule",
                  "default": "0 0 2 * * *"
                }
              }
            }
          }
        }
      }
    },
    "backup": {
      "title": "Backup",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "objectStore": {
          "type": "object",
          "title": "In-cluster backup object store (RustFS + Barman Cloud ObjectStore)",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Render the in-cluster object store",
              "description": "Requires postgres.mode=cnpg.",
              "default": false
            },
            "image": {
              "type": "string",
              "title": "RustFS image (digest-pinned)",
              "minLength": 1
            },
            "bucketJobImage": {
              "type": "string",
              "title": "Bucket-creation Job image (aws CLI, digest-pinned)",
              "minLength": 1
            },
            "storage": {
              "type": "string",
              "title": "Object store volume size",
              "default": "8Gi",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string",
              "title": "Storage class",
              "default": ""
            },
            "credentialsSecret": {
              "type": "string",
              "title": "Existing credentials Secret (ACCESS_KEY_ID, SECRET_ACCESS_KEY)",
              "description": "Empty generates one with random keys, re-used on upgrade.",
              "default": ""
            },
            "bucket": {
              "type": "string",
              "title": "Bucket",
              "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
              "default": "constellation-recovery"
            },
            "retentionPolicy": {
              "type": "string",
              "title": "Barman retention policy",
              "pattern": "^[1-9][0-9]*[dwm]$",
              "default": "7d"
            },
            "region": {
              "type": "string",
              "title": "SigV4 region",
              "minLength": 1,
              "default": "us-east-1"
            },
            "resources": {
              "type": "object",
              "title": "Object store container resources",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "tls": {
      "title": "Internal admission TLS",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "certManager": {
          "type": "object",
          "title": "cert-manager",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Use cert-manager",
              "default": false
            },
            "issuer": {
              "type": "string",
              "title": "Issuer name",
              "default": ""
            },
            "issuerKind": {
              "type": "string",
              "title": "Issuer kind",
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ],
              "default": "ClusterIssuer"
            },
            "createSelfSignedIssuer": {
              "type": "boolean",
              "title": "Create a private self-signed issuer",
              "default": false
            }
          }
        }
      }
    },
    "bootstrap": {
      "title": "Bootstrap administrator",
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerURL": {
              "type": "string"
            },
            "clientID": {
              "type": "string"
            },
            "clientSecretName": {
              "type": "string"
            },
            "audience": {
              "type": "string"
            },
            "redirectURL": {
              "type": "string"
            },
            "rolesClaim": {
              "type": "string"
            },
            "orgName": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "roleMapping": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "Auditor",
                  "Analyst",
                  "ClusterAdmin",
                  "SecurityAdmin",
                  "GlobalAdmin"
                ]
              }
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "breakGlass": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "existingSecret": {
              "type": "string"
            },
            "orgName": {
              "type": "string"
            },
            "sessionTTL": {
              "type": "string",
              "pattern": "^([1-9]m|10m)$"
            }
          }
        }
      }
    }
  }
}
