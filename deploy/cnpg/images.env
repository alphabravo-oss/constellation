# CloudNativePG operator + Barman Cloud plugin images for the in-cluster Postgres (installed
# outside the Helm release, in cnpg-system). Rebuilt by deploy/cnpg/build-images.sh from verified
# upstream tag commits on go1.27.3 (eMudhra floor), gated and cosign-signed; roll with the
# commands in docs/cnpg-recovery.md "Operator and plugin images".
CNPG_OPERATOR_IMAGE=ghcr.io/alphabravo-oss/constellation/cnpg-operator:1.30.1-go1.27.3@sha256:bf22d29787dc2c724e8f3aeba9637aabe6ae3594e51086d1ab118817dac06e1a
BARMAN_PLUGIN_IMAGE=ghcr.io/alphabravo-oss/constellation/barman-plugin:0.15.1-go1.27.3@sha256:0afdb8a5f9fc55ad558c25fdc30fc51dadf8037fdd44bed9a3dc7e75f978fb83
BARMAN_SIDECAR_IMAGE=ghcr.io/alphabravo-oss/constellation/barman-sidecar:0.15.1-go1.27.3@sha256:927a1de82c8b8b25c6517b2664965b229f70a2277a573a6243be7b556cac913a
