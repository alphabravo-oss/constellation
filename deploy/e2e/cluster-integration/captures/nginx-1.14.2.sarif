{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Constellation",
          "version": "dev",
          "fullName": "Constellation Container Security Platform",
          "informationUri": "https://constellation.alphabravo.io",
          "rules": [
            {
              "id": "CVE-2013-0337",
              "shortDescription": {
                "text": "The default configuration of nginx, possibly 1.3.13 and earlier, uses  ..."
              },
              "fullDescription": {
                "text": "The default configuration of nginx, possibly 1.3.13 and earlier, uses world-readable permissions for the (1) access.log and (2) error.log files, which allows local users to obtain sensitive information by reading the files."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2013-0337",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "low"
                ]
              }
            },
            {
              "id": "CVE-2016-2779",
              "shortDescription": {
                "text": "util-linux: runuser tty hijack via TIOCSTI ioctl"
              },
              "fullDescription": {
                "text": "runuser in util-linux allows local users to escape to the parent session via a crafted TIOCSTI ioctl call, which pushes characters to the terminal's input buffer."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2016-2779",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.8",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2016-2781",
              "shortDescription": {
                "text": "coreutils: Non-privileged session can escape to the parent session in chroot"
              },
              "fullDescription": {
                "text": "chroot in GNU coreutils, when used with --userspec, allows local users to escape to the parent session via a crafted TIOCSTI ioctl call, which pushes characters to the terminal's input buffer."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2016-2781",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "low"
                ]
              }
            },
            {
              "id": "CVE-2016-9318",
              "shortDescription": {
                "text": "libxml2: XML External Entity vulnerability"
              },
              "fullDescription": {
                "text": "libxml2 2.9.4 and earlier, as used in XMLSec 1.2.23 and earlier and other products, does not offer a flag directly indicating that the current document may be read but other files may not be opened, which makes it easier for remote attackers to conduct XML External Entity (XXE) attacks via a crafted document."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2016-9318",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2017-12424",
              "shortDescription": {
                "text": "shadow-utils: Buffer overflow via newusers tool"
              },
              "fullDescription": {
                "text": "In shadow before 4.5, the newusers tool could be made to manipulate internal data structures in ways unintended by the authors. Malformed input may lead to crashes (with a buffer overflow or other memory corruption) or other unspecified behaviors. This crosses a privilege boundary in, for example, certain web-hosting environments in which a Control Panel allows an unprivileged user account to create subaccounts."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2017-12424",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.8",
                "tags": [
                  "security",
                  "vulnerability",
                  "critical"
                ]
              }
            },
            {
              "id": "CVE-2017-12652",
              "shortDescription": {
                "text": "libpng: does not check length of chunks against user limit"
              },
              "fullDescription": {
                "text": "libpng before 1.6.32 does not properly check the length of chunks against the user limit."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2017-12652",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.8",
                "tags": [
                  "security",
                  "vulnerability",
                  "critical"
                ]
              }
            },
            {
              "id": "CVE-2017-16932",
              "shortDescription": {
                "text": "libxml2: Infinite recursion in parameter entities"
              },
              "fullDescription": {
                "text": "parser.c in libxml2 before 2.9.5 does not prevent infinite recursion in parameter entities."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2017-16932",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2017-18258",
              "shortDescription": {
                "text": "libxml2: Unrestricted memory usage in xz_head() function in xzlib.c"
              },
              "fullDescription": {
                "text": "The xz_head function in xzlib.c in libxml2 before 2.9.6 allows remote attackers to cause a denial of service (memory consumption) via a crafted LZMA file, because the decoder functionality does not restrict memory usage to what is required for a legitimate file."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2017-18258",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2017-20002",
              "shortDescription": {
                "text": "The Debian shadow package before 1:4.5-1 for Shadow incorrectly lists  ..."
              },
              "fullDescription": {
                "text": "The Debian shadow package before 1:4.5-1 for Shadow incorrectly lists pts/0 and pts/1 as physical terminals in /etc/securetty. This allows local users to login as password-less users even if they are connected by non-physical means such as SSH (hence bypassing PAM's nullok_secure configuration). This notably affects environments such as virtual machines automatically generated with a default blank root password, allowing all local users to escalate privileges."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2017-20002",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.8",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2017-5130",
              "shortDescription": {
                "text": "chromium-browser: heap overflow in libxml2"
              },
              "fullDescription": {
                "text": "An integer overflow in xmlmemory.c in libxml2 before 2.9.5, as used in Google Chrome prior to 62.0.3202.62 and other products, allowed a remote attacker to potentially exploit heap corruption via a crafted XML file."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2017-5130",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.8",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2017-5969",
              "shortDescription": {
                "text": "libxml2: Null pointer dereference in xmlSaveDoc implementation"
              },
              "fullDescription": {
                "text": "libxml2 2.9.4, when used in recover mode, allows remote attackers to cause a denial of service (NULL pointer dereference) via a crafted XML document.  NOTE: The maintainer states \"I would disagree of a CVE with the Recover parsing option which should only be used for manual recovery at least for XML parser."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2017-5969",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "4.7",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2017-6363",
              "shortDescription": {
                "text": "In the GD Graphics Library (aka LibGD) through 2.2.5, there is a heap- ..."
              },
              "fullDescription": {
                "text": "In the GD Graphics Library (aka LibGD) through 2.2.5, there is a heap-based buffer over-read in tiffWriter in gd_tiff.c. NOTE: the vendor says \"In my opinion this issue should not have a CVE, since the GD and GD2 formats are documented to be 'obsolete, and should only be used for development and testing purposes.'"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2017-6363",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.1",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2017-8872",
              "shortDescription": {
                "text": "libxml2: Out-of-bounds read in htmlParseTryOrFinish"
              },
              "fullDescription": {
                "text": "The htmlParseTryOrFinish function in HTMLparser.c in libxml2 2.9.4 allows attackers to cause a denial of service (buffer over-read) or information disclosure."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2017-8872",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.1",
                "tags": [
                  "security",
                  "vulnerability",
                  "critical"
                ]
              }
            },
            {
              "id": "CVE-2018-1000858",
              "shortDescription": {
                "text": "gnupg2: Cross site request forgery in dirmngr resulting in an information disclosure or denial of service"
              },
              "fullDescription": {
                "text": "GnuPG version 2.1.12 - 2.2.11 contains a Cross ite Request Forgery (CSRF) vulnerability in dirmngr that can result in Attacker controlled CSRF, Information Disclosure, DoS. This attack appear to be exploitable via Victim must perform a WKD request, e.g. enter an email address in the composer window of Thunderbird/Enigmail. This vulnerability appears to have been fixed in after commit 4a4bb874f63741026bd26264c43bb32b1099f060."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-1000858",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.8",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2018-1049",
              "shortDescription": {
                "text": "systemd: automount: access to automounted volumes can lock up"
              },
              "fullDescription": {
                "text": "In systemd prior to 234 a race condition exists between .mount and .automount units such that automount requests from kernel may not be serviced by systemd resulting in kernel holding the mountpoint and any processes that try to use said mount will hang. A race condition like this may lead to denial of service, until mount points are unmounted."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-1049",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.9",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2018-1152",
              "shortDescription": {
                "text": "libjpeg-turbo: Divide by zero allows for denial of service via crafted BMP image"
              },
              "fullDescription": {
                "text": "libjpeg-turbo 1.5.90 is vulnerable to a denial of service vulnerability caused by a divide by zero when processing a crafted BMP image."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-1152",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2018-12886",
              "shortDescription": {
                "text": "gcc: spilling of stack protection address in cfgexpand.c and function.c leads to stack-overflow protection bypass"
              },
              "fullDescription": {
                "text": "stack_protect_prologue in cfgexpand.c and stack_protect_epilogue in function.c in GNU Compiler Collection (GCC) 4.1 through 8 (under certain circumstances) generate instruction sequences when targeting ARM targets that spill the address of the stack protector guard, which allows an attacker to bypass the protection of -fstack-protector, -fstack-protector-all, -fstack-protector-strong, and -fstack-protector-explicit against stack overflow by controlling what the stack canary is compared against."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-12886",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.1",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2018-12900",
              "shortDescription": {
                "text": "libtiff: Heap-based buffer overflow in the cpSeparateBufToContigBuf function resulting in a denial of service or possibly code execution"
              },
              "fullDescription": {
                "text": "Heap-based buffer overflow in the cpSeparateBufToContigBuf function in tiffcp.c in LibTIFF 3.9.3, 3.9.4, 3.9.5, 3.9.6, 3.9.7, 4.0.0beta7, 4.0.0alpha4, 4.0.0alpha5, 4.0.0alpha6, 4.0.0, 4.0.1, 4.0.2, 4.0.3, 4.0.4, 4.0.4beta, 4.0.5, 4.0.6, 4.0.7, 4.0.8 and 4.0.9 allows remote attackers to cause a denial of service (crash) or possibly have unspecified other impact via a crafted TIFF file."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-12900",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.8",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2018-14404",
              "shortDescription": {
                "text": "libxml2: NULL pointer dereference in xmlXPathCompOpEval() function in xpath.c"
              },
              "fullDescription": {
                "text": "A NULL pointer dereference vulnerability exists in the xpath.c:xmlXPathCompOpEval() function of libxml2 through 2.9.8 when parsing an invalid XPath expression in the XPATH_OP_AND or XPATH_OP_OR case. Applications processing untrusted XSL format inputs with the use of the libxml2 library may be vulnerable to a denial of service attack due to a crash of the application."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-14404",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2018-14498",
              "shortDescription": {
                "text": "libjpeg-turbo: heap-based buffer over-read via crafted 8-bit BMP in get_8bit_row in rdbmp.c leads to denial of service"
              },
              "fullDescription": {
                "text": "get_8bit_row in rdbmp.c in libjpeg-turbo through 1.5.90 and MozJPEG through 3.3.1 allows attackers to cause a denial of service (heap-based buffer over-read and application crash) via a crafted 8-bit BMP in which one or more of the color indices is out of range for the number of palette entries."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-14498",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2018-14553",
              "shortDescription": {
                "text": "gd: NULL pointer dereference in gdImageClone"
              },
              "fullDescription": {
                "text": "gdImageClone in gd.c in libgd 2.1.0-rc2 through 2.2.5 has a NULL pointer dereference allowing attackers to crash an application via a specific function call sequence. Only affects PHP when linked with an external libgd (not bundled)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-14553",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "low"
                ]
              }
            },
            {
              "id": "CVE-2018-14567",
              "shortDescription": {
                "text": "libxml2: Infinite loop caused by incorrect error detection during LZMA decompression"
              },
              "fullDescription": {
                "text": "libxml2 2.9.8, if --with-lzma is used, allows remote attackers to cause a denial of service (infinite loop) via a crafted XML file that triggers LZMA_MEMLIMIT_ERROR, as demonstrated by xmllint, a different vulnerability than CVE-2015-8035 and CVE-2018-9251."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-14567",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2018-15686",
              "shortDescription": {
                "text": "systemd: line splitting via fgets() allows for state injection during daemon-reexec"
              },
              "fullDescription": {
                "text": "A vulnerability in unit_deserialize of systemd allows an attacker to supply arbitrary state across systemd re-execution via NotifyAccess. This can be used to improperly influence systemd execution and possibly lead to root privilege escalation. Affected releases are systemd versions up to and including 239."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-15686",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.8",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2018-16888",
              "shortDescription": {
                "text": "systemd: kills privileged process if unprivileged PIDFile was tampered"
              },
              "fullDescription": {
                "text": "It was discovered systemd does not correctly check the content of PIDFile files before using it to kill processes. When a service is run from an unprivileged user (e.g. User field set in the service file), a local attacker who is able to write to the PIDFile of the mentioned service may use this flaw to trick systemd into killing other services and/or privileged processes. Versions before v237 are vulnerable."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-16888",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "4.7",
                "tags": [
                  "security",
                  "vulnerability",
                  "low"
                ]
              }
            },
            {
              "id": "CVE-2018-17000",
              "shortDescription": {
                "text": "libtiff: NULL pointer dereference in function _TIFFmemcmp at tif_unix.c"
              },
              "fullDescription": {
                "text": "A NULL pointer dereference in the function _TIFFmemcmp at tif_unix.c (called from TIFFWriteDirectoryTagTransferfunction) in LibTIFF 4.0.9 allows an attacker to cause a denial-of-service through a crafted tiff file. This vulnerability can be triggered by the executable tiffcp."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-17000",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2018-17100",
              "shortDescription": {
                "text": "libtiff: Integer overflow in multiply_ms in tools/ppm2tiff.c"
              },
              "fullDescription": {
                "text": "An issue was discovered in LibTIFF 4.0.9. There is a int32 overflow in multiply_ms in tools/ppm2tiff.c, which can cause a denial of service (crash) or possibly have unspecified other impact via a crafted image file."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-17100",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.8",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2018-19210",
              "shortDescription": {
                "text": "libtiff: NULL pointer dereference in TIFFWriteDirectorySec function in tif_dirwrite.c"
              },
              "fullDescription": {
                "text": "In LibTIFF 4.0.9, there is a NULL pointer dereference in the TIFFWriteDirectorySec function in tif_dirwrite.c that will lead to a denial of service attack, as demonstrated by tiffset."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-19210",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2018-19211",
              "shortDescription": {
                "text": "ncurses: Null pointer dereference at function _nc_parse_entry in parse_entry.c"
              },
              "fullDescription": {
                "text": "In ncurses 6.1, there is a NULL pointer dereference at function _nc_parse_entry in parse_entry.c that will lead to a denial of service attack. The product proceeds to the dereference code path even after a \"dubious character `*' in name or alias field\" detection."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-19211",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "low"
                ]
              }
            },
            {
              "id": "CVE-2018-20482",
              "shortDescription": {
                "text": "tar: Infinite read loop in sparse_dump_region function in sparse.c"
              },
              "fullDescription": {
                "text": "GNU Tar through 1.30, when --sparse is used, mishandles file shrinkage during read access, which allows local users to cause a denial of service (infinite read loop in sparse_dump_region in sparse.c) by modifying a file that is supposed to be archived by a different user's process (e.g., a system backup running as root)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-20482",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "4.7",
                "tags": [
                  "security",
                  "vulnerability",
                  "medium"
                ]
              }
            },
            {
              "id": "CVE-2018-20843",
              "shortDescription": {
                "text": "expat: large number of colons in input makes parser consume high amount of resources, leading to DoS"
              },
              "fullDescription": {
                "text": "In libexpat in Expat before 2.2.7, XML input including XML names that contain a large number of colons could make the XML parser consume a high amount of RAM and CPU resources while processing (enough to be usable for denial-of-service attacks)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-20843",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "vulnerability",
                  "high"
                ]
              }
            },
            {
              "id": "CVE-2018-25009",
              "shortDescription": {
                "text": "libwebp: out-of-bounds read in WebPMuxCreateInternal"
              },
              "fullDescription": {
                "text": "A heap-based buffer overflow was found in libwebp in versions before 1.0.1 in GetLE16()."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-25009",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.1",
                "tags": [
                  "security",
                  "vulnerability",
                  "critical"
                ]
              }
            },
            {
              "id": "CVE-2018-25010",
              "shortDescription": {
                "text": "libwebp: out-of-bounds read in ApplyFilter()"
              },
              "fullDescription": {
