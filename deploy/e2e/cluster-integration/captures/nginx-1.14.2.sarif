            {
              "id": "CVE-2021-40812",
              "shortDescription": {
                "text": "The GD Graphics Library (aka LibGD) through 2.3.2 has an out-of-bounds ..."
              },
              "fullDescription": {
                "text": "The GD Graphics Library (aka LibGD) through 2.3.2 has an out-of-bounds read because of the lack of certain gdGetBuf and gdPutBuf return value checks."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2021-40812",
