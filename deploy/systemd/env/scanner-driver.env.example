# /etc/constellation/scanner-driver.env
# Loaded by constellation-scanner-driver.service.

DATABASE_URL=postgres://constellation:constellation@127.0.0.1:5432/constellation?sslmode=disable
API_URL=http://127.0.0.1:8080

# Max jobs to process per driver tick (per-org). Default 50.
#SCANNER_DRIVER_MAX=50

# Per-image scan timeout. Default 8m.
#SCANNER_DRIVER_JOB_TIMEOUT=8m
