# /etc/constellation/operator.env
# Loaded by constellation-operator.service. Operator is k8s-only — only set this up if
# you're running a hybrid (systemd control-plane + k8s data-plane) deployment.

KUBECONFIG=/var/lib/constellation/kubeconfig-operator.yaml

# Metrics + probe addresses.
#OPERATOR_METRICS_ADDR=:8081
#OPERATOR_PROBE_ADDR=:8082

# Namespace inside the watched cluster where managed workloads (scanner, runtime agent,
# admission webhook, audit cron) are created.
#OPERATOR_NAMESPACE=constellation-system

# Default runtime-agent image the operator will deploy.
#OPERATOR_AGENT_IMAGE=ghcr.io/alphabravocompany/constellation-agent:latest
