# /etc/constellation/api.env
# Loaded by constellation-api.service. KEY=VALUE only, no shell expansion.

# --- required ---------------------------------------------------------------

# Postgres URL. For unix-socket Postgres, use postgres:///constellation?host=/var/run/postgresql
DATABASE_URL=postgres://constellation:constellation@127.0.0.1:5432/constellation?sslmode=disable

# JWT signing keys (A5). Leave EMPTY (the default) to sign sessions RS256 with a
# shared keypair the api generates + persists in the session_signing_keys table on
# first boot — every replica shares it and `constellation-api --rotate-jwt-key`
# rotates it with no downtime. To override, set a PEM RSA/EC private key here
# (RS256/ES256). A raw hex/HS256 secret is rejected unless you also set
# CONSTELLATION_ALLOW_HS256_JWT=true (not recommended).
JWT_KEYS=
# false: an empty JWT_KEYS is the intended RS256 DB-backed path. Set true only when
# you supply JWT_KEYS and want startup to hard-fail if it is missing.
CONSTELLATION_REQUIRE_JWT_KEYS=false
#CONSTELLATION_ALLOW_HS256_JWT=false

# --- listen / network -------------------------------------------------------

LISTEN_ADDR=:8080

# --- jwt tuning -------------------------------------------------------------

JWT_ISSUER=constellation
JWT_AUDIENCE=constellation-api
JWT_TTL=1h

# --- CORS -------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173

# --- optional OIDC ----------------------------------------------------------
# Leave blank to disable OIDC and use local username/password auth only.

#OIDC_ISSUER_URL=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback

# --- optional Astronomer / external JWKS -----------------------------------

#ASTRONOMER_JWKS_URL=
#ASTRONOMER_JWT_ISSUER=
#ASTRONOMER_JWT_AUDIENCE=

# --- optional VulnDB readiness --------------------------------------------
# Leave optional for dev. Set required=true in production installs that should
# not serve ready until a constellation-vulndb store has been installed.

#CONSTELLATION_VULNDB_PATH=/var/lib/constellation/vulndb.bbolt
#CONSTELLATION_VULNDB_READY_REQUIRED=false
#CONSTELLATION_VULNDB_READY_MAX_AGE=168h

# --- observability ----------------------------------------------------------
# OTLP exporter target (host:port). Leave unset to disable export.

#OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
#OTEL_EXPORTER_OTLP_INSECURE=true
