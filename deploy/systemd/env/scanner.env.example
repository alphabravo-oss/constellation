# /etc/constellation/scanner.env
# Loaded by constellation-scanner.service and constellation-scanner@*.service.

# --- required ---------------------------------------------------------------

# Where the control plane lives.
CONSTELLATION_CONTROL_PLANE_URL=http://127.0.0.1:8080

# Service token issued by `constellationctl tokens issue scanner` (or generated by
# install.sh and registered out-of-band).
CONSTELLATION_SCANNER_TOKEN=REPLACE_ME

# --- tuning -----------------------------------------------------------------

# Defaults to runtime.NumCPU() if unset; cap explicitly for shared hosts.
#CONSTELLATION_SCANNER_MAX_CONCURRENT=4

# Health/metrics listener.
#SCANNER_LISTEN_ADDR=:8090

# --- trivy / syft / grype DB caches ----------------------------------------
# Point caches at the service workdir so they survive restarts.

XDG_CACHE_HOME=/var/lib/constellation/.cache
TRIVY_CACHE_DIR=/var/lib/constellation/.cache/trivy
GRYPE_DB_CACHE_DIR=/var/lib/constellation/.cache/grype
