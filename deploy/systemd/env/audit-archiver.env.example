# /etc/constellation/audit-archiver.env
# Loaded by constellation-audit-archiver.service (triggered daily by the .timer).

DATABASE_URL=postgres://constellation:constellation@127.0.0.1:5432/constellation?sslmode=disable

# S3 (or s3-compatible: MinIO, Ceph RGW) bucket to archive to.
AUDIT_BUCKET=constellation-audit-archive
AUDIT_PREFIX=audit

# Window to freeze in each run (24h = previous calendar day).
FREEZE_WINDOW=24h

# --- AWS credentials (or s3-compatible) ------------------------------------
# Standard AWS SDK env vars work; provide whichever applies in your env.

#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_ENDPOINT_URL_S3=https://minio.internal:9000   # for MinIO / Ceph

# --- cosign signing --------------------------------------------------------
# Either provide a key file (key-based) or set COSIGN_EXPERIMENTAL=1 for keyless+Fulcio.

#COSIGN_KEY=/etc/constellation/cosign.key
#COSIGN_PASSWORD=
#COSIGN_EXPERIMENTAL=1
