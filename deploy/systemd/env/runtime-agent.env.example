# /etc/constellation/runtime-agent.env
# Loaded by constellation-runtime-agent.service.

# --- required for upload mode (otherwise agent runs stdout-only) ------------

CONSTELLATION_API_URL=http://127.0.0.1:8080
RUNTIME_AGENT_TOKEN=REPLACE_ME

# --- eBPF object path -------------------------------------------------------

CONSTELLATION_BPF_OBJ=/opt/constellation/runtime.bpf.o

# --- batching ---------------------------------------------------------------

CONSTELLATION_BATCH_SIZE=200
CONSTELLATION_BATCH_INTERVAL_MS=2000

# --- identity ---------------------------------------------------------------
# Override the auto-detected $HOSTNAME label on emitted events.

#CONSTELLATION_NODE_NAME=node-01

# --- logging ----------------------------------------------------------------

CONSTELLATION_LOG_EVERY=50
