# /etc/constellation/discoverer.env  (or discoverer-<cluster>.env for the templated unit)
# Loaded by constellation-discoverer.service / constellation-discoverer@<cluster>.service.

# --- required ---------------------------------------------------------------

DATABASE_URL=postgres://constellation:constellation@127.0.0.1:5432/constellation?sslmode=disable

# Path to a kubeconfig with read access to Deployments/StatefulSets/DaemonSets across all
# namespaces you want discovered.
KUBECONFIG=/var/lib/constellation/kubeconfig-<cluster>.yaml

# Must match an existing row in the `clusters` table (created via the API/UI or
# `constellationctl clusters register`).
CLUSTER_NAME=<cluster>

# UUID of the org that owns the cluster.
ORG_ID=00000000-0000-0000-0000-000000000000

# --- tuning -----------------------------------------------------------------

# Comma/whitespace list of namespace globs to include (kube-system is always excluded).
NAMESPACE_FILTER=*

# How often to re-list + reconcile.
RECONCILE_INTERVAL=30s

# Run a single pass and exit (used by integration tests).
#ONE_SHOT=true
