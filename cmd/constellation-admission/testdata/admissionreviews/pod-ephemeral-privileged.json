{
  "kind": "AdmissionReview",
  "apiVersion": "admission.k8s.io/v1",
  "request": {
    "uid": "fixture-ephemeral",
    "kind": {
      "group": "",
      "version": "v1",
      "kind": "Pod"
    },
    "resource": {
      "group": "",
      "version": "v1",
      "resource": "pods"
    },
    "namespace": "default",
    "operation": "UPDATE",
    "userInfo": {
      "username": "system:serviceaccount:default:debugger"
    },
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "debug-target",
        "namespace": "default",
        "annotations": {
          "constellation.alphabravo.io/image-signed": "true"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "app",
            "image": "ghcr.io/acme/app@sha256:111",
            "securityContext": {
              "readOnlyRootFilesystem": true
            }
          }
        ],
        "ephemeralContainers": [
          {
            "name": "debugger",
            "image": "busybox:1.36",
            "targetContainerName": "app",
            "securityContext": {
              "privileged": true
            }
          }
        ]
      }
    }
  }
}
